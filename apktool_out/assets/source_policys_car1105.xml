<?xml version="1.0" encoding="utf-8"?>
<!--
    源标识
    字段说明
    cur_source 当前源
    in_source  切入源
    —————————————————————————————————————————————————————————
    |    动作      | 说明                                    |
    —————————————————————————————————————————————————————————
    |    mutex     | 互斥                                    |
    —————————————————————————————————————————————————————————
    |    interrupt | 中断                                    |
    —————————————————————————————————————————————————————————
    |    forbidden | 禁止（无需声明，不添加表示禁止走delayed策略）|
    —————————————————————————————————————————————————————————
    |    mix       | 混音                                    |
    —————————————————————————————————————————————————————————
-->
<strategy tag="策略">
    <!--
    StreamType 对应,该StreamType使用的策略对应
    ——————————————————————————————————————————————————————————
    |  id    |                 标识说明                        |
    ——————————————————————————————————————————————————————————
    | type   |          系统所用StreamType                     |
    ——————————————————————————————————————————————————————————
    |  use   |   将使用的策略名 policy标签里面的cur_source属性id值|
    ——————————————————————————————————————————————————————————
     -->
    <streams>
        <stream id="STREAM_NAVI" type="24" use="navi" tag="导航音"/>
        <stream id="STREAM_GIS" type="11" use="navi" tag="导航音"/>
        <stream id="STREAM_NAVI_CARPLAY" type="39" use="navi" tag="导航音(carplay)"/>
        <stream id="STREAM_NAVI_CARLIFE" type="40" use="navi" tag="导航音(carlife)"/>
        <stream id="STREAM_ALTERNATE" type="18" use="navi" tag="导航音(carplay)"/>

        <stream id="STREAM_ALARM" type="4" use="forever" tag="警告音"/>
        <stream id="STREAM_RADAR" type="28" use="warning_tip" tag="引擎盖提示"/>
        <stream id="STREAM_BACKCAR" type="12" use="reverse" tag="倒车"/>
        <stream id="STREAM_DVR" type="29" use="reverse" tag="AVM"/>
        <stream id="STREAM_ADAS" type="14" use="reverse" tag="adas"/>

        <stream id="STREAM_NOTIFICATION" type="5" use="notify" tag="语音"/>
        <stream id="STREAM_VOICE" type="26" use="vr_carplay_strong_siri" tag="语音"/>
        <stream id="STREAM_TTS" type="9" use="vr_tts" tag="语音"/>
        <stream id="STREAM_VOICE_CARPLAY" type="41" use="vr" tag="语音(carplay)"/>
        <stream id="STREAM_VOICE_CARLIFE" type="42" use="vr" tag="语音(carlife)"/>
        <stream id="STREAM_HDMI" type="35" use="vr" tag="手机互联"/>
        <stream id="STREAM_VOICE_ASSISTANT" type="17" use="vr" tag="语音"/>

        <stream id="STREAM_VOICE_CALL" type="0" use="bt_phone" tag="蓝牙电话"/>
        <stream id="STREAM_BLUETOOTH_SCO" type="6" use="bt_phone" tag="蓝牙电话"/>
        <stream id="STREAM_PHONE" type="21" use="bt_phone" tag="蓝牙电话"/>
        <stream id="STREAM_RING" type="2" use="bt_phone" tag="蓝牙铃声"/>
        <stream id="STREAM_VOIP" type="22" use="bt_phone" tag="手机互联电话"/>
        <stream id="STREAM_PHONE_CARLIFE" type="44" use="bt_phone" tag="carlife/hicar电话"/>
        <stream id="STREAM_PHONE_CARPLAY" type="43" use="bt_phone" tag="carplay电话"/>

        <stream id="STREAM_MUSIC" type="3" use="media" tag="媒体"/>
        <stream id="STREAM_VIDEO" type="49" use="media" tag="视频"/>
        <stream id="STREAM_RADIO" type="19" use="media" tag="收音机"/>
        <stream id="STREAM_A2DP" type="20" use="media" tag="蓝牙音乐"/>
        <stream id="STREAM_CARLIFE" type="34" use="media" tag="CARLIFE"/>
        <stream id="STREAM_CARPLAY" type="33" use="media_carplay" tag="CARPLAY"/>
        <stream id="STREAM_AUX" type="30" use="media" tag="U盘媒体"/>
        <stream id="STREAM_AUXIN" type="16" use="media" tag="收音机"/>

        <stream id="STREAM_TBOX" type="23" use="tbox" tag="E-CALL"/>

        <stream id="STREAM_SCREEN" type="32" use="screensaver" tag="屏保"/>

        <stream id="STREAM_STANDBY" type="31" use="standby" tag="待机"/>

        <stream id="STREAM_WARNING" type="48" use="warning" tag="警告"/>

    </streams>

    <!--
        音量曲线
        [id] 音量曲线名称，唯一ID值;
    -->
    <volumes>
        <volume id="media" value="-144,-69.0,-65.5,-61.5,-57.5,-53.5,-50.5,-47.5,-44.5,-41.5,-38.5,-35.5,-33.5,-31.5,-29.5,-27.5,-25.5,-23.5,-21.5,-19.5,-17.5,-15.5,-13.5,-11.5,-9.5,-8.5,-7.5,-6.5,-5.5,-4.5,-3.5,-2.5,-1.5"/>
        <volume id="navi" value="-144,-69.0,-65.5,-61.5,-57.5,-53.5,-50.5,-47.5,-44.5,-41.5,-38.5,-35.5,-33.5,-31.5,-29.5,-27.5,-25.5,-23.5,-21.5,-19.5,-17.5,-15.5,-13.5,-11.5,-9.5,-8.5,-7.5,-6.5,-5.5,-4.5,-3.5,-2.5,-1.5"/>
        <volume id="phone" value="-144,-69.0,-65.5,-61.5,-57.5,-53.5,-50.5,-47.5,-44.5,-41.5,-38.5,-35.5,-33.5,-31.5,-29.5,-27.5,-25.5,-23.5,-21.5,-19.5,-17.5,-15.5,-13.5,-11.5,-9.5,-8.5,-7.5,-6.5,-5.5,-4.5,-3.5,-2.5,-1.5"/>
        <volume id="ring" value="-144,-69.0,-65.5,-61.5,-57.5,-53.5,-50.5,-47.5,-44.5,-41.5,-38.5,-35.5,-33.5,-31.5,-29.5,-27.5,-25.5,-23.5,-21.5,-19.5,-17.5,-15.5,-13.5,-11.5,-9.5,-8.5,-7.5,-6.5,-5.5,-4.5,-3.5,-2.5,-1.5"/>
        <volume id="voice" value="-144,-69.0,-65.5,-61.5,-57.5,-53.5,-50.5,-47.5,-44.5,-41.5,-38.5,-35.5,-33.5,-31.5,-29.5,-27.5,-25.5,-23.5,-21.5,-19.5,-17.5,-15.5,-13.5,-11.5,-9.5,-8.5,-7.5,-6.5,-5.5,-4.5,-3.5,-2.5,-1.5"/>
        <volume id="null" value="-144"/>
    </volumes>

    <!--
        通道分配
        [id]     通道名称，唯一ID值;
        [index]  值必须为唯一，当use为native时必须是真实通道索引值;
        [value]  该通道流，对应streams里面stream id;
        [change] 是否需要切换通道，默认为false;
        [offset] 通道音量矫正值,默认值为0;

        [use] 取值为android和native，默认native;
              值为android（对应streams配置的type值,index为内部虚拟通道，实际不存在）时，走Android标准AudioSystem接口进行音量调节;
              值为native（必须有对应index值，index为真实通道，实际存在）时,走DSP接口进行音量调节;

        [min] 为最小索引值;
        [max] 为最大索引值;
        [def] 为默认索引值;
    -->
    <channels tag="虚拟/物理通道分配">
        <channel id="channel_media" index="1" value="STREAM_MUSIC,STREAM_VIDEO,STREAM_RADIO,STREAM_A2DP,STREAM_CARLIFE,STREAM_CARPLAY,STREAM_AUX,STREAM_AUXIN" change="true" use="android" min="0" max="32" def="12" volume="media" priority="0"/>
        <channel id="channel_phone" index="10" value="STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_TBOX" use="android" min="5" max="32" def="25" volume="phone" priority="3"/>
        <channel id="channel_ring" index="11" value="STREAM_RING" use="android" min="5" max="32" def="16" volume="ring" priority="4"/>
        <channel id="channel_navi" index="12" value="STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_ALTERNATE,STREAM_NAVI_CARLIFE" use="android" min="5" max="32" def="20" volume="navi" priority="1"/>
        <channel id="channel_vr" index="13" value="STREAM_NOTIFICATION,STREAM_VOICE,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE,STREAM_HDMI" use="android" min="5" max="32" def="16" volume="voice" priority="2"/>
        <channel id="channel_radar" index="14" value="STREAM_ALARM,STREAM_RADAR,STREAM_BACKCAR,STREAM_DVR,STREAM_ADAS" use="android" min="0" max="32" def="16" volume="phone"/>
        <channel id="channel_null"      index="15" value="STREAM_SCREEN,STREAM_STANDBY,STREAM_WARNING" use="android" min="0" max="0" def="0" volume="null"/>
    </channels>

    <!--
        源策略
        [id]    源名称，唯一ID值.通话源要包含phone字样、导航源要包含navi字样、语音源要包含vr字样、微信源要包含wechat字样、倒车源要包含reverse字样、屏保源要包含screensaver字样
        [tag]   标签
        [mix]   该源进入时，需要降音的通道ID集
        [mix_value] 降音百分比
        [mix_valid] 混音是否有效，默认有效
    -->
    <policy tag="策略表">

        <!--[多媒体]-->
        <cur_source id="media" tag="多媒体">
            <in_source id="STREAM_MUSIC,STREAM_VIDEO,STREAM_RADIO,STREAM_AUXIN,STREAM_A2DP,STREAM_CARLIFE,STREAM_CARPLAY,STREAM_AUX" action="mutex"/>
            <in_source id="STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_RING,STREAM_TBOX,STREAM_BACKCAR,STREAM_DVR,STREAM_ADAS,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE,STREAM_HDMI,STREAM_STANDBY,STREAM_RADAR" action="interrupt"/>
            <in_source id="STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_ALTERNATE,STREAM_NAVI_CARLIFE,STREAM_NOTIFICATION,STREAM_SCREEN,STREAM_WARNING,STREAM_ALARM,STREAM_VOICE" action="mix"/>
        </cur_source>

        <!--[多媒体]-->
        <cur_source id="media_carplay" tag="多媒体">
            <in_source id="STREAM_MUSIC,STREAM_VIDEO,STREAM_RADIO,STREAM_AUXIN,STREAM_A2DP,STREAM_CARLIFE,STREAM_CARPLAY,STREAM_AUX" action="mutex"/>
            <in_source id="STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_RING,STREAM_TBOX,STREAM_DVR,STREAM_ADAS,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE_CARLIFE,STREAM_HDMI,STREAM_STANDBY,STREAM_RADAR" action="interrupt"/>
            <in_source id="STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_ALTERNATE,STREAM_NAVI_CARLIFE,STREAM_NOTIFICATION,STREAM_SCREEN,STREAM_WARNING,STREAM_ALARM,STREAM_BACKCAR,STREAM_VOICE_CARPLAY,STREAM_VOICE" action="mix"/>
        </cur_source>

        <!--[蓝牙电话]-->
        <cur_source id="bt_phone" tag="蓝牙电话" mix="channel_navi" mix_value="20" mix_valid="true">
            <in_source id="STREAM_TBOX,STREAM_STANDBY" action="interrupt"/>
            <in_source id="STREAM_ALARM,STREAM_BACKCAR,STREAM_DVR,STREAM_ADAS,STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_ALTERNATE,STREAM_NAVI_CARLIFE,STREAM_RING,STREAM_WARNING,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_RADAR" action="mix"/>
        </cur_source>

        <!--[E-CALL]-->
        <cur_source id="tbox" tag="E-CALL">
            <in_source id="STREAM_STANDBY" action="interrupt"/>
            <in_source id="STREAM_WARNING,STREAM_ALARM,STREAM_TBOX,STREAM_RADAR" action="mix"/>
        </cur_source>

        <!--[倒车]-->
        <cur_source id="reverse" tag="倒车">
            <in_source id="STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_RING,STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_ALTERNATE,STREAM_NAVI_CARLIFE,STREAM_WARNING,STREAM_ALARM,STREAM_RADAR,STREAM_BACKCAR,STREAM_DVR,STREAM_ADAS" action="mix"/>
            <in_source id="STREAM_TBOX,STREAM_STANDBY" action="interrupt"/>
        </cur_source>

        <!--[导航]-->
        <cur_source id="navi" tag="导航" mix="channel_media" mix_value="20" mix_valid="true">
            <in_source id="STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_ALTERNATE,STREAM_NAVI_CARLIFE" action="mutex"/>
            <in_source id="STREAM_MUSIC,STREAM_VIDEO,STREAM_RADIO,STREAM_AUXIN,STREAM_A2DP,STREAM_CARLIFE,STREAM_CARPLAY,STREAM_AUX,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_RING,STREAM_ALARM,STREAM_BACKCAR,STREAM_DVR,STREAM_ADAS,STREAM_NOTIFICATION,STREAM_SCREEN,STREAM_WARNING" action="mix"/>
            <in_source id="STREAM_TBOX,STREAM_VOICE,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE,STREAM_HDMI,STREAM_STANDBY,STREAM_RADAR" action="interrupt"/>
        </cur_source>

        <!--[语音carplay增强siri]-->
        <cur_source id="vr_carplay_strong_siri" tag="语音">
            <in_source id="STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_RING,STREAM_TBOX,STREAM_BACKCAR,STREAM_DVR,STREAM_ADAS,STREAM_RADAR" action="mutex"/>
            <in_source id="STREAM_STANDBY" action="interrupt"/>
            <in_source id="STREAM_NOTIFICATION,STREAM_SCREEN,STREAM_WARNING,STREAM_ALARM,STREAM_VOICE,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE,STREAM_HDMI,STREAM_MUSIC,STREAM_VIDEO,STREAM_RADIO,STREAM_A2DP,STREAM_CARLIFE,STREAM_CARPLAY,STREAM_AUX,STREAM_AUXIN" action="mix"/>
        </cur_source>

        <!--[语音]-->
        <cur_source id="vr" tag="语音">
            <in_source id="STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_RING,STREAM_TBOX,STREAM_BACKCAR,STREAM_DVR,STREAM_ADAS,STREAM_RADAR" action="mutex"/>
            <in_source id="STREAM_STANDBY" action="interrupt"/>
            <in_source id="STREAM_NOTIFICATION,STREAM_SCREEN,STREAM_WARNING,STREAM_ALARM,STREAM_VOICE,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE,STREAM_HDMI" action="mix"/>
        </cur_source>

        <cur_source id="vr_tts" tag="电话留言">
            <in_source id="STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_RING,STREAM_TBOX,STREAM_BACKCAR,STREAM_DVR,STREAM_ADAS,STREAM_RADAR" action="mutex"/>
            <in_source id="STREAM_STANDBY,STREAM_RADIO" action="interrupt"/>
            <in_source id="STREAM_NOTIFICATION,STREAM_SCREEN,STREAM_WARNING,STREAM_ALARM,STREAM_VOICE,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE,STREAM_HDMI" action="mix"/>
        </cur_source>

        <cur_source id="notify" tag="通知音">
            <in_source id="STREAM_MUSIC,STREAM_VIDEO,STREAM_RADIO,STREAM_A2DP,STREAM_CARLIFE,STREAM_CARPLAY,STREAM_AUX,STREAM_AUXIN,STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_ALTERNATE,STREAM_NAVI_CARLIFE,STREAM_VOICE,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE,STREAM_HDMI,STREAM_SCREEN,STREAM_WARNING,STREAM_ALARM" action="mix"/>
            <in_source id="STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_TBOX,STREAM_RING,STREAM_BACKCAR,STREAM_DVR,STREAM_ADAS,STREAM_STANDBY,STREAM_NOTIFICATION,STREAM_RADAR" action="mutex"/>
        </cur_source>

        <!-- [屏保界面] -->
        <cur_source id="screensaver" tag="屏保">
            <in_source id="STREAM_STANDBY,STREAM_BACKCAR,STREAM_DVR,STREAM_ADAS,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_RING" action="interrupt"/>
            <in_source id="STREAM_MUSIC,STREAM_VIDEO,STREAM_RADIO,STREAM_A2DP,STREAM_CARLIFE,STREAM_CARPLAY,STREAM_AUX,STREAM_AUXIN,STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_ALTERNATE,STREAM_NAVI_CARLIFE,STREAM_WARNING,STREAM_ALARM,STREAM_TBOX,STREAM_RADAR,STREAM_NOTIFICATION" action="mix"/>
            <in_source id="STREAM_VOICE,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE,STREAM_HDMI" action="mutex"/>
        </cur_source>

        <!-- [待机] 除TBox通话，其他不容许源切入-->
        <cur_source id="standby" tag="待机">
            <in_source id="STREAM_STANDBY" action="mutex"/>
            <in_source id="STREAM_RADAR" action="mix"/>
        </cur_source>

        <cur_source id="warning" tag="警告">
            <in_source id="STREAM_STANDBY" action="interrupt"/>
            <in_source id="STREAM_MUSIC,STREAM_VIDEO,STREAM_RADIO,STREAM_A2DP,STREAM_CARLIFE,STREAM_CARPLAY,STREAM_AUX,STREAM_AUXIN,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_TBOX,STREAM_RING,STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_ALTERNATE,STREAM_NAVI_CARLIFE,STREAM_NOTIFICATION,STREAM_VOICE,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE,STREAM_HDMI,STREAM_ALARM,STREAM_BACKCAR,STREAM_DVR,STREAM_ADAS,STREAM_SCREEN,STREAM_RADAR" action="mix"/>
            <in_source id="STREAM_WARNING" action="mutex"/>
        </cur_source>

        <!--处理一些永久占着焦点不释放-->
        <cur_source id="forever" tag="无用焦点">
            <in_source id="STREAM_MUSIC,STREAM_VIDEO,STREAM_RADIO,STREAM_A2DP,STREAM_CARLIFE,STREAM_CARPLAY,STREAM_AUX,STREAM_AUXIN,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_TBOX,STREAM_RING,STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_ALTERNATE,STREAM_NAVI_CARLIFE,STREAM_NOTIFICATION,STREAM_VOICE,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE,STREAM_HDMI,STREAM_ALARM,STREAM_BACKCAR,STREAM_DVR,STREAM_ADAS,STREAM_SCREEN,STREAM_WARNING,STREAM_RADAR" action="mix"/>
            <in_source id="STREAM_STANDBY" action="interrupt"/>
        </cur_source>

        <cur_source id="warning_tip" tag="引擎盖提示">
            <in_source id="STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_TBOX,STREAM_RING,STREAM_ALARM,STREAM_RADAR,STREAM_BACKCAR,STREAM_DVR,STREAM_ADAS,STREAM_SCREEN,STREAM_STANDBY,STREAM_WARNING" action="mix"/>
        </cur_source>

    </policy>

</strategy>