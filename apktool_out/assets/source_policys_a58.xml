<?xml version="1.0" encoding="utf-8"?>
<!--
    源标识
    字段说明
    cur_source 当前源
    in_source  切入源
    —————————————————————————————————————————————————————————
    |    动作      | 说明                                    |
    —————————————————————————————————————————————————————————
    |    mutex     | 互斥                                    |
    —————————————————————————————————————————————————————————
    |    interrupt | 中断                                    |
    —————————————————————————————————————————————————————————
    |    forbidden | 禁止（无需声明，不添加表示禁止走delayed策略）|
    —————————————————————————————————————————————————————————
    |    mix       | 混音                                    |
    —————————————————————————————————————————————————————————
-->
<strategy tag="策略">
    <!--
    StreamType 对应,该StreamType使用的策略对应
    ——————————————————————————————————————————————————————————
    |  id    |                 标识说明                        |
    ——————————————————————————————————————————————————————————
    | type   |          系统所用StreamType                     |
    ——————————————————————————————————————————————————————————
    |  use   |   将使用的策略名 policy标签里面的cur_source属性id值|
    ——————————————————————————————————————————————————————————
     -->
    <streams>
        <stream id="STREAM_NAVI" type="24" use="navi" tag="导航音"/>
        <stream id="STREAM_GIS" type="11" use="navi" tag="导航音"/>
        <stream id="STREAM_NAVI_CARPLAY" type="39" use="navi_carplay" tag="导航音(carplay)"/>
        <stream id="STREAM_NAVI_CARLIFE" type="40" use="navi_carlife" tag="导航音(carlife/hicar)"/>
        <stream id="STREAM_ALTERNATE" type="18" use="navi_carplay" tag="导航音(carplay)"/>

        <stream id="STREAM_ALARM" type="4" use="adas_mix" tag="adas(混音)"/>
        <stream id="STREAM_RADAR" type="28" use="adas_not_mix" tag="adas(不混音)"/>
        <stream id="STREAM_AUX" type="30" use="adas_mix_drop" tag="adas(混降)"/>

        <stream id="STREAM_BACKCAR" type="12" use="reverse_mix" tag="倒车(混音)"/>
        <stream id="STREAM_DVR" type="29" use="reverse_not_mix" tag="倒车(不混音)"/>
        <stream id="STREAM_ADAS" type="14" use="reverse_mix_drop" tag="倒车(混降)"/>

<!--        <stream id="STREAM_ADAS" type="14" use="cluster" tag="cluster"/>-->

        <stream id="STREAM_NOTIFICATION" type="5" use="notify" tag="提示音"/>
        <stream id="STREAM_VOICE_ASSISTANT" type="17" use="vr" tag="语音"/>
        <stream id="STREAM_TTS" type="9" use="vr" tag="TTS播报"/>
        <stream id="STREAM_VOICE" type="26" use="vr_carplay_strong_siri" tag="语音消息"/>
        <stream id="STREAM_VOICE_CARPLAY" type="41" use="vr_carplay" tag="语音(carplay)"/>
        <stream id="STREAM_VOICE_CARLIFE" type="42" use="vr_carlife" tag="语音(carlife/hicar)"/>

        <stream id="STREAM_VOICE_CALL" type="0" use="bt_phone" tag="蓝牙电话"/>
        <stream id="STREAM_BLUETOOTH_SCO" type="6" use="bt_phone" tag="蓝牙电话"/>
        <stream id="STREAM_PHONE" type="21" use="bt_phone" tag="蓝牙电话"/>
        <stream id="STREAM_RING" type="2" use="bt_phone" tag="蓝牙铃声"/>
        <stream id="STREAM_VOIP" type="22" use="bt_phone" tag="网络电话"/>
        <stream id="STREAM_PHONE_CARLIFE" type="44" use="bt_phone" tag="carlife/hicar电话"/>
        <stream id="STREAM_PHONE_CARPLAY" type="43" use="bt_phone" tag="carplay电话"/>

        <stream id="STREAM_MUSIC" type="3" use="media" tag="多媒体"/>
<!--        <stream id="STREAM_VIDEO" type="49" use="media" tag="多媒体"/>-->
        <stream id="STREAM_RADIO" type="19" use="media" tag="收音机"/>
        <stream id="STREAM_A2DP" type="20" use="media" tag="蓝牙音乐"/>
<!--        <stream id="STREAM_AUX" type="30" use="media" tag="外设输入"/>-->
        <stream id="STREAM_AUXIN" type="16" use="media" tag="收音机"/>
        <stream id="STREAM_CARLIFE" type="34" use="media_carlife" tag="CARLIFE/hicar"/>
        <stream id="STREAM_CARPLAY" type="33" use="media_carplay" tag="CARPLAY"/>

        <stream id="STREAM_TBOX" type="23" use="tbox" tag="紧急救援"/>

        <stream id="STREAM_SCREEN" type="32" use="screensaver" tag="屏保"/>

        <stream id="STREAM_STANDBY" type="31" use="standby" tag="待机"/>

        <stream id="STREAM_WARNING" type="48" use="warning" tag="警告"/>

    </streams>

    <!--
        音量曲线
        [id] 音量曲线名称，唯一ID值;
    -->
    <!--                            0                            5                            10                            15                            20                            25                            30                        35                  39 -->
    <volumes>
        <volume id="media" value="-120,-68.6,-62.6,-57.6,-53.6,-50.6,-48.6,-46.6,-44.6,-42.6,-40.6,-38.6,-36.6,-34.6,-32.6,-30.6,-28.6,-26.6,-24.6,-22.6,-20.5,-19.5,-18.5,-17.5,-16.5,-15.5,-14.5,-13.5,-12.5,-11.5,-10.5,-9.5,-8.5,-7.5,-6.5,-5.5,-4.8,-3,-1.3,-0.5"/>
        <volume id="voice" value="-120,-48.6,-36.6,-26.6,-20.5,-16.5,-10.5,-5.5,-3,-1,0"/>
        <volume id="phone" value="-120,-48.6,-36.6,-26.6,-20.5,-16.5,-10.5,-5.5,-3,-1,0"/>
        <volume id="navi" value="-120,-48.6,-36.6,-26.6,-20.5,-16.5,-10.5,-5.5,-3,-1,0"/>
        <volume id="null" value="-120"/>
    </volumes>

    <!--
        通道分配
        [id]     通道名称，唯一ID值;
        [index]  值必须为唯一，当use为native时必须是真实通道索引值;
        [value]  该通道流，对应streams里面stream id;
        [change] 是否需要切换通道，默认为false;
        [offset] 通道音量矫正值,默认值为0;

        [use] 取值为android和native，默认native;
              值为android（对应streams配置的type值,index为内部虚拟通道，实际不存在）时，走Android标准AudioSystem接口进行音量调节;
              值为native（必须有对应index值，index为真实通道，实际存在）时,走DSP接口进行音量调节;

        [min] 为最小索引值;
        [max] 为最大索引值;
        [def] 为默认索引值;
        [priority] 为多个通道同时在播时，音量调节优先选择调节的通道，值越大优先级越高，没有这个属性或者属性值小于0，则为不可调，不参与优先级比较
    -->
    <channels tag="虚拟/物理通道分配">
        <channel id="channel_media"     index="2" value="STREAM_MUSIC,STREAM_A2DP,STREAM_AUXIN,STREAM_CARLIFE,STREAM_CARPLAY,STREAM_RADIO" change="false" use="android" min="0" max="39" def="12" volume="media" priority="0"/>
        <channel id="channel_tbox"      index="9" value="STREAM_TBOX" use="android" min="0" max="10" def="5" volume="phone" priority="5"/>
        <channel id="channel_notify"    index="10" value="STREAM_NOTIFICATION,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE" use="android" min="0" max="10" def="5" volume="voice" priority="2"/>
        <channel id="channel_ring"      index="15" value="STREAM_RING" use="android" min="3" max="10" def="5" volume="phone" priority="4"/>
        <channel id="channel_phone"     index="11" value="STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY" use="android" min="3" max="10" def="5" volume="phone" priority="3"/>
        <channel id="channel_navi"      index="12" value="STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_NAVI_CARLIFE,STREAM_ALTERNATE" use="android" min="0" max="10" def="5" volume="navi" priority="1"/>
        <channel id="channel_radar"     index="13" value="STREAM_ALARM,STREAM_RADAR,STREAM_BACKCAR,STREAM_DVR,STREAM_ADAS,STREAM_AUX" use="android" min="0" max="10" def="5" volume="phone"/>
        <channel id="channel_null"      index="14" value="STREAM_SCREEN,STREAM_STANDBY,STREAM_WARNING" use="android" min="0" max="0" def="0" volume="null"/>
    </channels>

    <!--
        源策略
        [id]    源名称，唯一ID值.通话源要包含phone字样、导航源要包含navi字样、语音源要包含vr字样、微信源要包含wechat字样、倒车源要包含reverse字样、屏保源要包含screensaver字样
        [tag]   标签
        [mix]   该源进入时，需要降音的通道ID集
        [mix_value] 降音百分比
        [mix_valid] 混音是否有效，默认有效
    -->
    <policy tag="策略表">

        <!--[tbox电话]-->
        <cur_source id="tbox" tag="E/B/I-CALL">
            <in_source id="STREAM_ALARM,STREAM_RADAR,STREAM_BACKCAR,STREAM_DVR,STREAM_ADAS,STREAM_AUX" action="mix"/>
        </cur_source>

        <!--[蓝牙电话]-->
        <cur_source id="bt_phone" tag="蓝牙电话" mix="channel_navi" mix_value="20" mix_valid="true">
            <in_source id="STREAM_TBOX,STREAM_STANDBY,STREAM_WARNING" action="interrupt"/>
            <in_source id="STREAM_ALARM,STREAM_RADAR,STREAM_BACKCAR,STREAM_ADAS,STREAM_AUX,STREAM_DVR,STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_NAVI_CARLIFE,STREAM_ALTERNATE,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY" action="mix"/>
        </cur_source>

        <!--[辅助音]-->
<!--        <cur_source id="cluster" tag="辅助音">-->
<!--            <in_source id="STREAM_MUSIC,STREAM_VIDEO,STREAM_A2DP,STREAM_AUX,STREAM_AUXIN,STREAM_CARLIFE,STREAM_CARPLAY,STREAM_RADIO,STREAM_TBOX,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_ALTERNATE,STREAM_NAVI_CARLIFE,STREAM_ALARM,STREAM_RADAR,STREAM_BACKCAR,STREAM_DVR,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_WARNING" action="mix"/>-->
<!--            <in_source id="STREAM_ADAS" action="mutex"/>-->
<!--            <in_source id="STREAM_STANDBY" action="interrupt"/>-->
<!--        </cur_source>-->

        <!--[倒车不混音]-->
        <cur_source id="reverse_not_mix" tag="倒车不混音">
            <in_source id="STREAM_TBOX,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_ALARM,STREAM_RADAR,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_WARNING,STREAM_AUX,STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_NAVI_CARLIFE,STREAM_ALTERNATE,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE" action="mix"/>
            <in_source id="STREAM_STANDBY" action="interrupt"/>
        </cur_source>

        <!--[倒车混音]-->
        <cur_source id="reverse_mix" tag="倒车混音">
            <in_source id="STREAM_TBOX,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_ALARM,STREAM_RADAR,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_MUSIC,STREAM_A2DP,STREAM_AUXIN,STREAM_CARLIFE,STREAM_CARPLAY,STREAM_RADIO,STREAM_WARNING,STREAM_BACKCAR,STREAM_AUX,STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_NAVI_CARLIFE,STREAM_ALTERNATE,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE" action="mix"/>
            <in_source id="STREAM_STANDBY" action="interrupt"/>
        </cur_source>

        <!--[倒车混降音]-->
        <cur_source id="reverse_mix_drop" tag="倒车混降音" mix="channel_media" mix_value="20" mix_valid="true">
            <in_source id="STREAM_TBOX,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_ALARM,STREAM_RADAR,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_MUSIC,STREAM_A2DP,STREAM_AUXIN,STREAM_CARLIFE,STREAM_CARPLAY,STREAM_RADIO,STREAM_WARNING,STREAM_ADAS,STREAM_AUX,STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_NAVI_CARLIFE,STREAM_ALTERNATE,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE" action="mix"/>
            <in_source id="STREAM_STANDBY" action="interrupt"/>
        </cur_source>

        <!--[adas不混音]-->
        <cur_source id="adas_not_mix" tag="adas不混音">
            <in_source id="STREAM_TBOX,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_BACKCAR,STREAM_ADAS,STREAM_AUX,STREAM_DVR,STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_ALTERNATE,STREAM_NAVI_CARLIFE,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_WARNING,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE" action="mix"/>
            <in_source id="STREAM_ALARM,STREAM_RADAR" action="mutex"/>
            <in_source id="STREAM_STANDBY" action="interrupt"/>
        </cur_source>

        <!--[adas混音]-->
        <cur_source id="adas_mix" tag="adas混音">
            <in_source id="STREAM_MUSIC,STREAM_A2DP,STREAM_AUXIN,STREAM_CARLIFE,STREAM_CARPLAY,STREAM_RADIO,STREAM_TBOX,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_ALTERNATE,STREAM_NAVI_CARLIFE,STREAM_BACKCAR,STREAM_ADAS,STREAM_AUX,STREAM_DVR,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_WARNING" action="mix"/>
            <in_source id="STREAM_ALARM,STREAM_RADAR" action="mutex"/>
            <in_source id="STREAM_STANDBY" action="interrupt"/>
        </cur_source>

        <!--[adas混降音]-->
        <cur_source id="adas_mix_drop" tag="adas混降音" mix="channel_media" mix_value="20" mix_valid="true">
            <in_source id="STREAM_TBOX,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_ALARM,STREAM_RADAR,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_MUSIC,STREAM_A2DP,STREAM_AUXIN,STREAM_CARLIFE,STREAM_CARPLAY,STREAM_RADIO,STREAM_WARNING,STREAM_ADAS,STREAM_AUX,STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_NAVI_CARLIFE,STREAM_ALTERNATE,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE" action="mix"/>
            <in_source id="STREAM_STANDBY" action="interrupt"/>
        </cur_source>

        <!--[导航]-->
        <cur_source id="navi" tag="导航" mix="channel_media" mix_value="20" mix_valid="true">
            <in_source id="STREAM_TBOX,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE,STREAM_STANDBY,STREAM_WARNING" action="interrupt"/>
            <in_source id="STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_ALARM,STREAM_BACKCAR,STREAM_ADAS,STREAM_AUX,STREAM_MUSIC,STREAM_A2DP,STREAM_AUXIN,STREAM_CARLIFE,STREAM_CARPLAY,STREAM_RADIO,STREAM_SCREEN,STREAM_NOTIFICATION,STREAM_RADAR,STREAM_DVR" action="mix"/>
            <in_source id="STREAM_NAVI_CARPLAY,STREAM_ALTERNATE,STREAM_NAVI_CARLIFE" action="mutex"/>
        </cur_source>

        <!--[导航carplay]-->
        <cur_source id="navi_carplay" tag="导航carplay" mix="channel_media" mix_value="20" mix_valid="true">
            <in_source id="STREAM_TBOX,STREAM_NAVI,STREAM_GIS" action="mutex"/>
            <in_source id="STREAM_ALARM,STREAM_RADAR,STREAM_BACKCAR,STREAM_ADAS,STREAM_AUX,STREAM_MUSIC,STREAM_AUXIN,STREAM_CARLIFE,STREAM_CARPLAY,STREAM_RADIO,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_NAVI_CARPLAY,STREAM_NAVI_CARLIFE,STREAM_ALTERNATE,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE,STREAM_SCREEN,STREAM_NOTIFICATION,STREAM_DVR" action="mix"/>
            <in_source id="STREAM_STANDBY,STREAM_WARNING" action="interrupt"/>
        </cur_source>

        <!--[导航carlife]-->
        <cur_source id="navi_carlife" tag="导航carlife" mix="channel_media" mix_value="20" mix_valid="true">
            <in_source id="STREAM_TBOX,STREAM_STANDBY,STREAM_WARNING" action="interrupt"/>
            <in_source id="STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_ALARM,STREAM_RADAR,STREAM_BACKCAR,STREAM_ADAS,STREAM_AUX,STREAM_MUSIC,STREAM_A2DP,STREAM_AUXIN,STREAM_CARLIFE,STREAM_RADIO,STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_NAVI_CARLIFE,STREAM_ALTERNATE,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE,STREAM_SCREEN,STREAM_NOTIFICATION,STREAM_DVR" action="mix"/>
        </cur_source>

        <!--[多媒体]-->
        <cur_source id="media" tag="多媒体">
            <in_source id="STREAM_TBOX,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_RADAR,STREAM_DVR,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE,STREAM_STANDBY,STREAM_WARNING" action="interrupt"/>
            <in_source id="STREAM_ALARM,STREAM_BACKCAR,STREAM_ADAS,STREAM_AUX,STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_ALTERNATE,STREAM_NAVI_CARLIFE,STREAM_SCREEN,STREAM_NOTIFICATION,STREAM_VOICE" action="mix"/>
            <in_source id="STREAM_MUSIC,STREAM_A2DP,STREAM_AUXIN,STREAM_CARLIFE,STREAM_CARPLAY,STREAM_RADIO" action="mutex"/>
        </cur_source>

        <!--[多媒体carplay]-->
        <cur_source id="media_carplay" tag="多媒体carplay">
            <in_source id="STREAM_TBOX,STREAM_MUSIC,STREAM_A2DP,STREAM_AUXIN,STREAM_CARLIFE,STREAM_CARPLAY,STREAM_RADIO" action="mutex"/>
            <in_source id="STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_RADAR,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE,STREAM_STANDBY,STREAM_WARNING" action="interrupt"/>
            <in_source id="STREAM_ALARM,STREAM_BACKCAR,STREAM_ADAS,STREAM_AUX,STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_ALTERNATE,STREAM_NAVI_CARLIFE,STREAM_SCREEN,STREAM_NOTIFICATION,STREAM_DVR,STREAM_VOICE" action="mix"/>
        </cur_source>

        <!--[多媒体carlife]-->
        <cur_source id="media_carlife" tag="多媒体">
            <in_source id="STREAM_TBOX,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_RADAR,STREAM_DVR,STREAM_STANDBY,STREAM_WARNING" action="interrupt"/>
            <in_source id="STREAM_ALARM,STREAM_BACKCAR,STREAM_ADAS,STREAM_AUX,STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_ALTERNATE,STREAM_NAVI_CARLIFE,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE,STREAM_SCREEN,STREAM_NOTIFICATION" action="mix"/>
            <in_source id="STREAM_MUSIC,STREAM_A2DP,STREAM_AUXIN,STREAM_CARLIFE,STREAM_CARPLAY,STREAM_RADIO" action="mutex"/>
        </cur_source>

        <!--[语音carplay，增强siri]-->
        <cur_source id="vr_carplay_strong_siri" tag="语音carplay">
            <in_source id="STREAM_TBOX,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY" action="mutex"/>
            <in_source id="STREAM_ALARM,STREAM_RADAR,STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_NAVI_CARLIFE,STREAM_ALTERNATE,STREAM_CARLIFE,STREAM_CARPLAY,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE,STREAM_SCREEN,STREAM_NOTIFICATION,STREAM_MUSIC,STREAM_A2DP,STREAM_AUXIN,STREAM_RADIO,STREAM_DVR,STREAM_ADAS,STREAM_BACKCAR,STREAM_AUX" action="mix"/>
            <in_source id="STREAM_STANDBY,STREAM_WARNING" action="interrupt"/>
        </cur_source>

        <!--[语音carplay，非增强siri]-->
        <cur_source id="vr_carplay" tag="语音carplay">
            <in_source id="STREAM_TBOX,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_MUSIC,STREAM_A2DP,STREAM_AUXIN,STREAM_RADIO" action="mutex"/>
            <in_source id="STREAM_ALARM,STREAM_RADAR,STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_NAVI_CARLIFE,STREAM_ALTERNATE,STREAM_CARLIFE,STREAM_CARPLAY,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE,STREAM_SCREEN,STREAM_NOTIFICATION,STREAM_DVR,STREAM_ADAS,STREAM_BACKCAR,STREAM_AUX" action="mix"/>
            <in_source id="STREAM_STANDBY,STREAM_WARNING" action="interrupt"/>
        </cur_source>

        <!--[语音carlife]-->
        <cur_source id="vr_carlife" tag="语音carlife">
            <in_source id="STREAM_TBOX,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_MUSIC,STREAM_A2DP,STREAM_AUXIN,STREAM_RADIO" action="mutex"/>
            <in_source id="STREAM_ALARM,STREAM_RADAR,STREAM_NAVI,STREAM_GIS,STREAM_NAVI_CARPLAY,STREAM_NAVI_CARLIFE,STREAM_ALTERNATE,STREAM_CARLIFE,STREAM_CARPLAY,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_VOICE,STREAM_VOICE_CARPLAY,STREAM_VOICE_CARLIFE,STREAM_SCREEN,STREAM_NOTIFICATION,STREAM_DVR,STREAM_ADAS,STREAM_BACKCAR,STREAM_AUX" action="mix"/>
            <in_source id="STREAM_STANDBY,STREAM_WARNING" action="interrupt"/>
        </cur_source>

        <!--[语音]-->
        <cur_source id="vr" tag="语音">
            <in_source id="STREAM_TBOX,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_PHONE_CARLIFE,STREAM_PHONE_CARPLAY,STREAM_MUSIC,STREAM_A2DP,STREAM_AUXIN,STREAM_CARLIFE,STREAM_CARPLAY" action="mutex"/>
            <in_source id="STREAM_ALARM,STREAM_RADAR,STREAM_SCREEN,STREAM_NOTIFICATION,STREAM_DVR,STREAM_ADAS,STREAM_BACKCAR,STREAM_AUX" action="mix"/>
            <in_source id="STREAM_STANDBY,STREAM_WARNING,STREAM_RADIO" action="interrupt"/>
