<?xml version="1.0" encoding="utf-8"?>
<!--
    源标识
    字段说明
    cur_source 当前源
    in_source  切入源
    —————————————————————————————————————————————————————————
    |    动作      | 说明                                    |
    —————————————————————————————————————————————————————————
    |    mutex     | 互斥                                    |
    —————————————————————————————————————————————————————————
    |    interrupt | 中断                                    |
    —————————————————————————————————————————————————————————
    |    forbidden | 禁止（无需声明，不添加表示禁止走delayed策略）|
    —————————————————————————————————————————————————————————
    |    mix       | 混音                                    |
    —————————————————————————————————————————————————————————
-->
<strategy tag="策略">
    <!--
    StreamType 对应,该StreamType使用的策略对应
    ——————————————————————————————————————————————————————————
    |  id    |                 标识说明                        |
    ——————————————————————————————————————————————————————————
    | type   |          系统所用StreamType                     |
    ——————————————————————————————————————————————————————————
    |  use   |   将使用的策略名 policy标签里面的cur_source属性id值|
    ——————————————————————————————————————————————————————————
     -->
    <streams>
        <stream id="STREAM_NAVI" type="24" use="navi" tag="导航音(carlife/other)"/>
        <stream id="STREAM_GIS" type="11" use="navi_carplay" tag="导航音(carplay)"/>

        <stream id="STREAM_BEEP" type="25" use="notification" tag="按键音"/>

        <stream id="STREAM_ALARM" type="4" use="cluster" tag="警报音"/>

        <stream id="STREAM_CAR_ALARM" type="38" use="adas_not_mix" tag="雷达(不混音)"/>

        <stream id="STREAM_RADAR" type="28" use="adas_mix" tag="雷达(混音)"/>

        <stream id="STREAM_NOTIFICATION" type="5" use="vr" tag="提示音"/>
        <stream id="STREAM_VOICE_ASSISTANT" type="17" use="vr" tag="语音(carplay)"/>
        <stream id="STREAM_TTS" type="9" use="vr" tag="TTS播报(carlife)"/>

        <stream id="STREAM_VOICE" type="26" use="vr" tag="语音消息"/>

        <stream id="STREAM_BACKCAR" type="12" use="reverse_mix" tag="倒车(混音)"/>
        <stream id="STREAM_DVR" type="29" use="reverse_not_mix" tag="倒车(不混音)"/>
        <stream id="STREAM_SVC" type="36" use="reverse_mix" tag="盲区显示"/>

        <stream id="STREAM_VOICE_CALL" type="0" use="bt_phone" tag="蓝牙电话"/>
        <stream id="STREAM_BLUETOOTH_SCO" type="6" use="bt_phone" tag="蓝牙电话"/>
        <stream id="STREAM_PHONE" type="21" use="bt_phone" tag="蓝牙电话"/>
        <stream id="STREAM_RING" type="2" use="bt_phone" tag="蓝牙铃声"/>
        <stream id="STREAM_VOIP" type="22" use="bt_phone" tag="网络电话"/>

        <stream id="STREAM_MUSIC" type="3" use="media" tag="多媒体"/>
        <stream id="STREAM_VIDEO" type="49" use="media" tag="多媒体"/>
        <stream id="STREAM_RADIO" type="19" use="media" tag="收音机"/>
        <stream id="STREAM_A2DP" type="20" use="media" tag="蓝牙音乐"/>
        <stream id="STREAM_AUX" type="30" use="media" tag="外设输入"/>
        <stream id="STREAM_CARPLAY" type="33" use="media_carplay" tag="CARPLAY"/>
        <stream id="STREAM_CARLIFE" type="34" use="media" tag="CARLIFE"/>
        <stream id="STREAM_AUXIN" type="16" use="media" tag="AUX IN输入"/>

        <stream id="STREAM_TBOX" type="23" use="tbox" tag="紧急救援"/>

        <stream id="STREAM_SCREEN" type="32" use="screensaver" tag="屏保"/>

        <stream id="STREAM_STANDBY" type="31" use="standby" tag="待机"/>
    </streams>

    <!--
        音量曲线
        [id] 音量曲线名称，唯一ID值;
    -->
    <!--                            0                            5                            10                            15                            20                            25                            30                        35                  39 -->
    <volumes>
        <volume id="media" value="-144,-69.0,-64.7,-61.7,-59.0,-57.0,-55.5,-54.0,-51.5,-49.5,-47.5,-45.5,-43.5,-41.5,-39.5,-37.5,-36.5,-35.5,-34.5,-33.0,-31.0,-29.0,-27.0,-25.0,-23.0,-21.0,-19.0,-17.0,-15.0,-13.0,-11.0,-9.0,-8.0,-7.0,-6.0,-5.0,-4.8,-4.5,-4.3,-4.0"/>
        <volume id="voice" value="-144,-80.0,-69.0,-64.7,-61.7,-59.0,-57.0,-55.5,-54.0,-51.5,-49.5"/>
        <volume id="phone" value="-144,-80.0,-69.2,-60.7,-56.4,-49.2,-45.2,-42.2,-39.3,-36.6,-34.5"/>
        <volume id="navi" value="-144,-80.0,-69.2,-60.7,-56.4,-49.2,-45.2,-42.2,-39.3,-36.6,-34.5"/>
        <volume id="null" value="-89.6"/>
    </volumes>

    <!--
        通道分配
        [id]     通道名称，唯一ID值;
        [index]  值必须为唯一，当use为native时必须是真实通道索引值;
        [value]  该通道流，对应streams里面stream id;
        [change] 是否需要切换通道，默认为false;
        [offset] 通道音量矫正值,默认值为0;

        [use] 取值为android和native，默认native;
              值为android（对应streams配置的type值,index为内部虚拟通道，实际不存在）时，走Android标准AudioSystem接口进行音量调节;
              值为native（必须有对应index值，index为真实通道，实际存在）时,走DSP接口进行音量调节;

        [min] 为最小索引值;
        [max] 为最大索引值;
        [def] 为默认索引值;
    -->
    <channels tag="虚拟/物理通道分配">
        <channel id="channel_media"     index="2" value="STREAM_MUSIC,STREAM_VIDEO,STREAM_A2DP,STREAM_AUX,STREAM_CARPLAY,STREAM_CARLIFE,STREAM_AUXIN,STREAM_RADIO" change="false" use="android" min="0" max="39" def="12" volume="media"/>
        <channel id="channel_tbox"      index="9" value="STREAM_TBOX" use="android" min="0" max="10" def="5" volume="phone"/>
        <channel id="channel_notify"    index="10" value="STREAM_NOTIFICATION,STREAM_VOICE_ASSISTANT,STREAM_TTS,STREAM_BEEP,STREAM_VOICE" use="android" min="0" max="10" def="5" volume="voice"/>
        <channel id="channel_phone"     index="11" value="STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP" use="android" min="0" max="10" def="5" volume="phone"/>
        <channel id="channel_navi"      index="12" value="STREAM_NAVI,STREAM_GIS" use="android" min="0" max="10" def="5" volume="navi"/>
        <channel id="channel_radar"     index="13" value="STREAM_ALARM,STREAM_CAR_ALARM,STREAM_RADAR,STREAM_BACKCAR,STREAM_DVR,STREAM_SVC" use="android" min="0" max="10" def="5" volume="phone"/>
        <channel id="channel_null"      index="14" value="STREAM_SCREEN,STREAM_STANDBY" use="android" min="0" max="0" def="0" volume="null"/>
    </channels>

    <!--
        源策略
        [id]    源名称，唯一ID值.通话源要包含phone字样、导航源要包含navi字样、语音源要包含vr字样、微信源要包含wechat字样、倒车源要包含reverse字样、屏保源要包含screensaver字样
        [tag]   标签
        [mix]   该源进入时，需要降音的通道ID集
        [mix_value] 降音百分比
        [mix_valid] 混音是否有效，默认有效
    -->
    <policy tag="策略表">

        <!--[tbox电话]-->
        <cur_source id="tbox" tag="E/B/I-CALL">
            <in_source id="STREAM_ALARM,STREAM_CAR_ALARM,STREAM_RADAR,STREAM_BACKCAR,STREAM_DVR,STREAM_SVC" action="mix"/>
        </cur_source>

        <!--[蓝牙电话]-->
        <cur_source id="bt_phone" tag="蓝牙电话" mix="channel_navi" mix_value="20" mix_valid="true">
            <in_source id="STREAM_TBOX" action="interrupt"/>
            <in_source id="STREAM_ALARM,STREAM_CAR_ALARM,STREAM_RADAR,STREAM_BACKCAR,STREAM_DVR,STREAM_SVC,STREAM_NAVI,STREAM_GIS" action="mix"/>
        </cur_source>

        <!--[倒车不混音]-->
        <cur_source id="reverse_not_mix" tag="倒车不混音">
            <in_source id="STREAM_TBOX,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_ALARM,STREAM_CAR_ALARM,STREAM_RADAR" action="mix"/>
        </cur_source>

        <!--[倒车混音]-->
        <cur_source id="reverse_mix" tag="倒车混音">
            <in_source id="STREAM_TBOX,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_ALARM,STREAM_CAR_ALARM,STREAM_RADAR" action="mix"/>
        </cur_source>

        <!--[辅助音]-->
        <cur_source id="cluster" tag="辅助音">
            <in_source id="STREAM_TBOX,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_BACKCAR,STREAM_DVR,STREAM_SVC,STREAM_NAVI,STREAM_GIS,STREAM_MUSIC,STREAM_VIDEO,STREAM_A2DP,STREAM_AUX,STREAM_CARPLAY,STREAM_CARLIFE,STREAM_AUXIN,STREAM_RADIO,STREAM_VOICE_ASSISTANT,STREAM_TTS" action="mix"/>
        </cur_source>

        <!--[adas不混音]-->
        <cur_source id="adas_not_mix" tag="adas不混音">
            <in_source id="STREAM_TBOX,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_BACKCAR,STREAM_DVR,STREAM_SVC,STREAM_NAVI,STREAM_GIS,STREAM_VOICE_ASSISTANT,STREAM_TTS" action="mix"/>
        </cur_source>

        <!--[adas混音]-->
        <cur_source id="adas_mix" tag="adas混音">
            <in_source id="STREAM_TBOX,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_BACKCAR,STREAM_DVR,STREAM_SVC,STREAM_NAVI,STREAM_GIS,STREAM_MUSIC,STREAM_VIDEO,STREAM_A2DP,STREAM_AUX,STREAM_CARPLAY,STREAM_CARLIFE,STREAM_AUXIN,STREAM_RADIO,STREAM_VOICE_ASSISTANT,STREAM_TTS" action="mix"/>
        </cur_source>

        <!--[导航]-->
        <cur_source id="navi" tag="导航" mix="channel_media" mix_value="20" mix_valid="true">
            <in_source id="STREAM_TBOX,STREAM_DVR,STREAM_VOICE_ASSISTANT,STREAM_TTS" action="interrupt"/>
            <in_source id="STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_ALARM,STREAM_CAR_ALARM,STREAM_RADAR,STREAM_BACKCAR,STREAM_SVC,STREAM_MUSIC,STREAM_VIDEO,STREAM_A2DP,STREAM_AUX,STREAM_CARPLAY,STREAM_CARLIFE,STREAM_AUXIN,STREAM_RADIO" action="mix"/>
            <in_source id="STREAM_NAVI,STREAM_GIS" action="mutex"/>
        </cur_source>

        <!--[导航carplay]-->
        <cur_source id="navi_carplay" tag="导航carplay" mix="channel_media" mix_value="20" mix_valid="true">
            <in_source id="STREAM_TBOX,STREAM_NAVI" action="mutex"/>
            <in_source id="STREAM_ALARM,STREAM_CAR_ALARM,STREAM_RADAR,STREAM_BACKCAR,STREAM_SVC,STREAM_MUSIC,STREAM_VIDEO,STREAM_A2DP,STREAM_AUX,STREAM_CARPLAY,STREAM_CARLIFE,STREAM_AUXIN,STREAM_RADIO" action="mix"/>
            <in_source id="STREAM_DVR" action="interrupt"/>
        </cur_source>

        <!--[多媒体]-->
        <cur_source id="media" tag="多媒体">
            <in_source id="STREAM_TBOX,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_DVR,STREAM_VOICE_ASSISTANT,STREAM_TTS" action="interrupt"/>
            <in_source id="STREAM_ALARM,STREAM_CAR_ALARM,STREAM_RADAR,STREAM_BACKCAR,STREAM_SVC,STREAM_NAVI,STREAM_GIS" action="mix"/>
            <in_source id="STREAM_MUSIC,STREAM_VIDEO,STREAM_A2DP,STREAM_AUX,STREAM_CARPLAY,STREAM_CARLIFE,STREAM_AUXIN,STREAM_RADIO" action="mutex"/>
        </cur_source>

        <!--[多媒体carplay]-->
        <cur_source id="media_carplay" tag="多媒体carplay">
            <in_source id="STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_DVR,STREAM_VOICE_ASSISTANT,STREAM_TTS" action="interrupt"/>
            <in_source id="STREAM_ALARM,STREAM_CAR_ALARM,STREAM_RADAR,STREAM_BACKCAR,STREAM_SVC,STREAM_NAVI,STREAM_GIS" action="mix"/>
            <in_source id="STREAM_TBOX,STREAM_MUSIC,STREAM_VIDEO,STREAM_A2DP,STREAM_AUX,STREAM_CARPLAY,STREAM_CARLIFE,STREAM_AUXIN,STREAM_RADIO" action="mutex"/>
        </cur_source>

        <!--[语音]-->
        <cur_source id="vr" tag="语音">
            <in_source id="STREAM_TBOX,STREAM_VOICE_CALL,STREAM_BLUETOOTH_SCO,STREAM_PHONE,STREAM_RING,STREAM_VOIP,STREAM_BACKCAR,STREAM_DVR,STREAM_SVC,STREAM_MUSIC,STREAM_VIDEO,STREAM_A2DP,STREAM_AUX,STREAM_CARPLAY,STREAM_CARLIFE,STREAM_AUXIN,STREAM_RADIO" action="mutex"/>
            <in_source id="STREAM_ALARM,STREAM_CAR_ALARM,STREAM_RADAR" action="mix"/>
        </cur_source>

        <!-- [屏保界面] -->
        <cur_source id="screensaver" tag="屏保">
            <in_source id="STREAM_STANDBY" action="mutex"/>
        </cur_source>

        <!-- [待机] 除TBox通话，其他不容许源切入-->
        <cur_source id="standby" tag="待机">
            <in_source id="STREAM_TBOX" action="interrupt"/>
        </cur_source>

    </policy>
</strategy>