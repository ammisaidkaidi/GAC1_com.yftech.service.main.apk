<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="horizontal" android:background="#00ffff" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:layout_width="0.0dp" android:layout_height="wrap_content" android:text="DTS" android:layout_weight="1.0" />
            <Switch android:id="@id/sDtsEnable" android:background="#0000ff" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <RadioGroup android:orientation="horizontal" android:id="@id/rgDtsSoundPosition" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <RadioButton android:id="@id/rbDtsSoundPositionFront" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="front" />
            <RadioButton android:id="@id/rbDtsSoundPositionRear" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="rear" />
            <RadioButton android:id="@id/rbDtsSoundPositionAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="all" />
        </RadioGroup>
        <RadioGroup android:orientation="horizontal" android:id="@id/rgDtsType" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <RadioButton android:id="@id/rbDtsTypeDefault" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="default" />
            <RadioButton android:id="@id/rbDtsTypeVoice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="voice" />
            <RadioButton android:id="@id/rbDtsTypeSuperBass" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="super bass" />
            <RadioButton android:id="@id/rbDtsTypeSoothing" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="soothing" />
        </RadioGroup>
        <LinearLayout android:orientation="horizontal" android:background="#00ffff" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:layout_width="0.0dp" android:layout_height="wrap_content" android:text="均衡器" android:layout_weight="1.0" />
            <Switch android:id="@id/sEqEnable" android:background="#0000ff" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:id="@id/llEqBand" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <RadioGroup android:orientation="horizontal" android:id="@id/rgEqType" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <RadioButton android:id="@id/rbEqTypeCustom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="custom" />
            <RadioButton android:id="@id/rbEqTypeDefault" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="default" />
            <RadioButton android:id="@id/rbEqTypeVoice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="voice" />
            <RadioButton android:id="@id/rbEqTypeFolk" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="folk" />
            <RadioButton android:id="@id/rbEqTypeRock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="rock" />
            <RadioButton android:id="@id/rbEqTypeJazz" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="jazz" />
            <RadioButton android:id="@id/rbEqTypePop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="pop" />
            <RadioButton android:id="@id/rbEqTypeDance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="dance" />
            <RadioButton android:id="@id/rbEqTypeClassic" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="classic" />
            <RadioButton android:id="@id/rbEqTypeTrebleBoost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="treble boost" />
            <RadioButton android:id="@id/rbEqTypeBassBoost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="bass boost" />
        </RadioGroup>
        <TextView android:background="#00ffff" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="声场延时" />
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="10.0dp" android:paddingEnd="10.0dp">
            <view android:id="@id/lvDelay" android:background="#00ff00" android:layout_width="0.0dp" android:layout_height="200.0dp" android:foreground="@drawable/center_line" android:layout_weight="1.0" class="com.yftech.service.main.testui.SoundEffectFragment$LocationView" />
            <Button android:id="@id/btnDelayReset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="reset" />
        </LinearLayout>
        <TextView android:background="#00ffff" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="声场平衡" />
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="10.0dp" android:paddingEnd="10.0dp">
            <view android:id="@id/lvBalance" android:background="#00ff00" android:layout_width="0.0dp" android:layout_height="200.0dp" android:foreground="@drawable/center_line" android:layout_weight="1.0" class="com.yftech.service.main.testui.SoundEffectFragment$LocationView" />
            <Button android:id="@id/btnBalanceReset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="reset" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:background="#00ffff" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:layout_width="0.0dp" android:layout_height="wrap_content" android:text="等响度" android:layout_weight="1.0" />
            <Switch android:id="@id/sLoudness" android:background="#0000ff" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
