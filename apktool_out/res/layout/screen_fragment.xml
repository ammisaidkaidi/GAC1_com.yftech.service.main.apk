<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:id="@id/llRoot" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:background="#00ffff" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="亮度" />
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="10.0dp" android:paddingEnd="10.0dp">
            <SeekBar android:id="@id/sbBrightness" android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0" />
            <TextView android:id="@id/tvBrightness" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView android:background="#00ffff" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="关屏" />
        <RadioGroup android:orientation="horizontal" android:id="@id/rgCloseScreen" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <RadioButton android:id="@id/rbForceCloseScreen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="force close" />
            <RadioButton android:id="@id/rbForceOpenScreen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="force open" />
            <RadioButton android:id="@id/rbForeverCloseScreen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="forever close" />
            <RadioButton android:id="@id/rbForeverOpenScreen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="forever open" />
            <RadioButton android:id="@id/rbTempCloseScreen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="temp close" />
            <RadioButton android:id="@id/rbTempOpenScreen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="temp open" />
        </RadioGroup>
        <TextView android:background="#00ffff" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="日夜模式" />
        <RadioGroup android:orientation="horizontal" android:id="@id/rgDayNightMode" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <RadioButton android:id="@id/rbDayMode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="day" />
            <RadioButton android:id="@id/rbNightMode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="night" />
            <RadioButton android:id="@id/rbAutoMode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="auto" />
        </RadioGroup>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="屏幕亮度曲线调试：" />
            <Button android:id="@id/btnSetBrightnessCurveValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="设置亮度值：" />
            <EditText android:id="@id/etSetBrightnessCurveValue" android:background="#00ffff" android:layout_width="0.0dp" android:layout_height="wrap_content" android:hint="输入值" android:layout_weight="1.0" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="亮度曲线当前亮度：" />
            <SeekBar android:layout_gravity="center_horizontal" android:id="@id/sbGetBrightnessCurve" android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="8.0" />
            <TextView android:layout_gravity="center_horizontal" android:id="@id/tvGetBrightnessCurve" android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
